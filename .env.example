# Supabase Dashboard > Project Settings > API Keys
# The URL must be the project root, not an endpoint such as /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Older projects may keep using NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# The app supports either PUBLISHABLE_KEY or ANON_KEY.


# Server-side moderation security. Never commit the service role key to GitHub.
# Set MPD_OWNER_USER_ID to the UUID of the owner's Supabase Auth user.
MPD_OWNER_USER_ID=YOUR_OWNER_SUPABASE_AUTH_UUID
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# Public copy of the owner's UUID, used only to show the owner badge in the UI.
# This UUID is not a password; server APIs still verify the signed-in session.
NEXT_PUBLIC_MPD_OWNER_USER_ID=YOUR_OWNER_SUPABASE_AUTH_UUID

# Optional compatibility only: if an older project already uses this PostgreSQL
# URL for the guestbook, it remains supported. If omitted, Supabase stores it.
# DATABASE_URL=
